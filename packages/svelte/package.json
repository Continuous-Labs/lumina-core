{
  "name": "@continuouslabs/lumina-svelte",
  "version": "1.2.2",
  "description": "The official Svelte adapter for Lumina i18n",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "keywords": [
    "i18n",
    "svelte",
    "svelte5",
    "lumina",
    "internationalization"
  ],
  "author": "Felix Jara",
  "license": "MIT",
  "peerDependencies": {
    "@continuouslabs/lumina": "workspace:*",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "svelte": "5.0.0-next.1"
  },
  "devDependencies": {
    "@continuouslabs/lumina": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "5.7.3"
  }
}
